# Copy this file to .env.local and fill in the values from
# Supabase -> Project Settings -> API Keys (and Data API for the URL).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# The "publishable" key (sb_publishable_...) or the legacy "anon" key. Safe to expose.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (sb_secret_...) or the legacy "service_role" key. NEVER share this.
SUPABASE_SECRET_KEY=
